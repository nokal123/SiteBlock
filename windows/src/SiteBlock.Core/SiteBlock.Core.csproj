<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# port of SiteBlockCore: every blocking rule, with no Windows calls, so it builds and is tested on any system. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SiteBlock.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SiteBlock.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The family DNS providers file is shared with the Mac version and lives in its source; it is built into this library so the installed programs need no file beside them. -->
    <EmbeddedResource Include="..\..\..\Sources\SiteBlockCore\FamilyDNSProviders.json" LogicalName="FamilyDNSProviders.json" />
  </ItemGroup>
</Project>
