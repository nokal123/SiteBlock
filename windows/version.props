<Project>
  <!-- The Windows version people see is <WindowsSeries>.<builds since WindowsSeriesFirstBuild>. Change both together to start a new series. -->
  <PropertyGroup>
    <WindowsSeries>1.0</WindowsSeries>
    <!-- The commit count of the first Windows build published from master, which is therefore 1.0.0. The commit that set it is number 88 on the windows branch;
         master holds nothing windows lacks, so merging windows into master with a fast-forward right after makes that commit master's first Windows build. If more
         commits land first, raise this to master's commit count at the merge; the workflow refuses to publish a first release that is not 1.0.0 and names the number. -->
    <WindowsSeriesFirstBuild>88</WindowsSeriesFirstBuild>
  </PropertyGroup>
</Project>
