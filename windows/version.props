<Project>
  <!-- The Windows version people see is <WindowsSeries>.<SiteBlockBuildNumber - WindowsSeriesFirstBuild>. Change the series and its first build together to start a new series. -->
  <PropertyGroup>
    <WindowsSeries>1.0</WindowsSeries>
    <!-- The build number of the first Windows release, 1.0.0. -->
    <WindowsSeriesFirstBuild>88</WindowsSeriesFirstBuild>
    <!-- The release number. To publish a Windows release, raise it by one and push to master: the Windows workflow publishes a build only when this number is
         higher than the published one, so a push that leaves it alone is built and tested but not released. Installed copies take an update only when its number
         is higher than their own, so this number never goes down. -->
    <SiteBlockBuildNumber>95</SiteBlockBuildNumber>
  </PropertyGroup>
</Project>
